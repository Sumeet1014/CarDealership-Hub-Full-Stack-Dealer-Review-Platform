# Django (names must match settings.py: SECRET_KEY, DEBUG, ALLOWED_HOSTS)
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for local development)
DATABASE_ENGINE=sqlite

# Demo user created by `python manage.py seed_data`.
# On Render set these to values of your choosing; never commit the real password.
SEED_DEMO_USERNAME=testuser
SEED_DEMO_EMAIL=test@test.com
SEED_DEMO_PASSWORD=change-me

# CORS / frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
